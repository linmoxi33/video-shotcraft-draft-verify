#!/usr/bin/env python3
"""Offline structural verifier for JianYing / CapCut draft directories.

Reads the draft JSON files that video-shotcraft's jianying-export writes
(draft_info.json / draft_content.json + draft_meta_info.json) and checks
referential integrity, timeranges, bundled media, material-pool registration
and machine-fingerprint leakage -- without launching JianYing.

Exit codes: 0 pass, 1 findings (error severity), 2 usage / unreadable input.
"""

import argparse
import json
import os
import sys

TOOL = "video-shotcraft-draft-verify"
VERSION = "1.0.0"

TRACK_GROUP = {
    "video": "videos",
    "audio": "audios",
    "text": "texts",
    "sticker": "stickers",
    "image": "images",
}
MEDIA_GROUPS = ("videos", "audios", "images")
PRIVACY_KEYS = ("device_id", "hard_disk_id", "mac_address")


class InputError(Exception):
    """The draft cannot be inspected at all (exit 2)."""


def _is_win_abs(path):
    return len(path) >= 3 and path[1] == ":" and path[2] in "\\/"


def _load(path):
    try:
        with open(path, "rb") as fh:
            raw = fh.read()
        return json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise InputError("%s: %s" % (os.path.basename(path), exc))


def _resolve(path, base):
    """Return (kind, absolute) where kind is posix, external or winabs."""
    if not isinstance(path, str) or not path:
        return "empty", ""
    if _is_win_abs(path):
        return "winabs", path
    absolute = path if os.path.isabs(path) else os.path.join(base, path)
    absolute = os.path.realpath(absolute)
    try:
        inside = os.path.commonpath([absolute, base]) == base
    except ValueError:
        inside = False
    return ("posix" if inside else "external"), absolute


def _range(value):
    if not isinstance(value, dict):
        return None
    start, duration = value.get("start"), value.get("duration")
    if not isinstance(start, int) or not isinstance(duration, int):
        return None
    return start, duration


def _fmt_us(value):
    return "%.6fs" % (value / 1_000_000.0) if isinstance(value, int) else str(value)


def verify(draft_dir, strict=False, allow_external=False):
    findings = []

    def add(code, severity, message, where):
        findings.append({"id": code, "severity": severity,
                         "message": message, "where": where})

    given = draft_dir
    draft_dir = os.path.realpath(draft_dir)
    if not os.path.isdir(draft_dir):
        raise InputError("not a directory: %s" % draft_dir)

    mac_path = os.path.join(draft_dir, "draft_info.json")
    win_path = os.path.join(draft_dir, "draft_content.json")
    has_mac, has_win = os.path.isfile(mac_path), os.path.isfile(win_path)
    if not has_mac and not has_win:
        raise InputError("neither draft_info.json nor draft_content.json found")

    entry = mac_path if has_mac else win_path
    content = _load(entry)
    if not isinstance(content, dict):
        raise InputError("entry JSON is not an object")

    if has_mac and has_win:
        with open(mac_path, "rb") as a, open(win_path, "rb") as b:
            if a.read() != b.read():
                add("J003", "error",
                    "draft_info.json and draft_content.json differ; Mac and "
                    "Windows import paths would see different timelines",
                    "draft_info.json / draft_content.json")

    for key, kind in (("duration", int), ("tracks", list), ("materials", dict),
                      ("canvas_config", dict), ("fps", (int, float))):
        if key not in content or not isinstance(content[key], kind):
            add("J001", "error", "missing or mistyped top-level field %r" % key,
                key)

    duration = content.get("duration")
    tracks = content.get("tracks") if isinstance(content.get("tracks"), list) else []
    materials = content.get("materials") if isinstance(content.get("materials"), dict) else {}

    material_index = {}
    media = []
    for group, items in materials.items():
        if not isinstance(items, list):
            add("J002", "warning", "materials.%s is not a list" % group,
                "materials.%s" % group)
            continue
        for i, item in enumerate(items):
            if not isinstance(item, dict):
                add("J004", "warning", "material is not an object",
                    "materials.%s[%d]" % (group, i))
                continue
            mid = item.get("id")
            if not isinstance(mid, str) or not mid:
                add("J005", "error", "material without usable id",
                    "materials.%s[%d]" % (group, i))
                continue
            if mid in material_index:
                add("J006", "error", "duplicate material id %r" % mid,
                    "materials.%s[%d]" % (group, i))
                continue
            material_index[mid] = (group, item)
            if group in MEDIA_GROUPS and item.get("path"):
                media.append((group, i, item))

    track_count = segment_count = 0
    seen_tracks = set()
    for ti, track in enumerate(tracks):
        where = "tracks[%d]" % ti
        if not isinstance(track, dict):
            add("J010", "error", "track is not an object", where)
            continue
        ttype = track.get("type")
        if ttype not in TRACK_GROUP:
            add("J010", "error", "unknown track type %r" % ttype, where)
            continue
        tid = track.get("id")
        if isinstance(tid, str):
            if tid in seen_tracks:
                add("J007", "error", "duplicate track id %r" % tid, where)
            seen_tracks.add(tid)
        track_count += 1
        segments = track.get("segments") if isinstance(track.get("segments"), list) else []
        if not isinstance(track.get("segments"), list):
            add("J008", "warning", "track has no segments list", where)
        spans = []
        for si, seg in enumerate(segments):
            segment_count += 1
            swhere = "%s.segments[%d]" % (where, si)
            if not isinstance(seg, dict):
                add("J009", "error", "segment is not an object", swhere)
                continue
            mid = seg.get("material_id")
            if not isinstance(mid, str) or mid not in material_index:
                add("J011", "error",
                    "segment references unknown material_id %r" % (mid,), swhere)
            else:
                group = material_index[mid][0]
                expected = TRACK_GROUP.get(ttype)
                if expected and group != expected:
                    add("J012", "error",
                        "material %r lives in materials.%s but sits on a %s "
                        "track" % (mid, group, ttype), swhere)
                mat = material_index[mid][1]
                source = _range(seg.get("source_timerange"))
                m_dur = mat.get("duration")
                if source is not None and isinstance(m_dur, int) and m_dur > 0:
                    s_start, s_dur = source
                    if s_start < 0 or s_dur <= 0:
                        add("J015", "error", "invalid source_timerange %r" % (source,), swhere)
                    elif s_start + s_dur > m_dur:
                        add("J015", "error",
                            "source range %s + %s exceeds material duration %s"
                            % (_fmt_us(s_start), _fmt_us(s_dur), _fmt_us(m_dur)),
                            swhere)
            target = _range(seg.get("target_timerange"))
            if target is None:
                add("J013", "error", "missing/invalid target_timerange", swhere)
            else:
                start, dur = target
                if start < 0 or dur <= 0:
                    add("J013", "error", "invalid target_timerange %r" % (target,), swhere)
                else:
                    spans.append((start, start + dur, si))
                    if isinstance(duration, int) and start + dur > duration:
                        add("J014", "error",
                            "target end %s exceeds draft duration %s"
                            % (_fmt_us(start + dur), _fmt_us(duration)), swhere)
        spans.sort()
        for (s1, e1, a), (s2, e2, b) in zip(spans, spans[1:]):
            if s2 < e1:
                add("J016", "error",
                    "segments %d and %d overlap on the same track "
                    "(%s..%s vs %s..%s)" % (a, b, _fmt_us(s1), _fmt_us(e1),
                                            _fmt_us(s2), _fmt_us(e2)),
                    where)

    for group, i, item in media:
        where = "materials.%s[%d].path" % (group, i)
        kind, absolute = _resolve(item.get("path"), draft_dir)
        if kind == "winabs":
            add("J025", "warning",
                "Windows absolute path cannot be checked on this host: %s"
                % item.get("path"), where)
            continue
        if kind == "external":
            sev = "error" if strict or not allow_external else "warning"
            add("J021", sev,
                "media path escapes the draft directory: %s" % item.get("path"), where)
        if not os.path.isfile(absolute):
            add("J020", "error", "media file does not exist: %s" % item.get("path"), where)

    meta_path = os.path.join(draft_dir, "draft_meta_info.json")
    has_meta = os.path.isfile(meta_path)
    meta = None
    if has_meta:
        meta = _load(meta_path)
        if not isinstance(meta, dict):
            raise InputError("draft_meta_info.json is not an object")
    platform = content.get("platform") if isinstance(content.get("platform"), dict) else {}
    is_mac = platform.get("os") == "mac"

    if not has_meta:
        add("J024", "error" if is_mac else "warning",
            "draft_meta_info.json is absent; Mac JianYing needs type-0 media "
            "registration or it reports missing media", "draft_meta_info.json")
    else:
        registered = {}
        groups = meta.get("draft_materials")
        if isinstance(groups, list):
            for group in groups:
                if isinstance(group, dict) and group.get("type") == 0:
                    for rec in group.get("value") or []:
                        if isinstance(rec, dict) and isinstance(rec.get("file_Path"), str):
                            kind, absolute = _resolve(rec["file_Path"], draft_dir)
                            registered[absolute] = rec
        for group, i, item in media:
            kind, absolute = _resolve(item.get("path"), draft_dir)
            if kind == "winabs":
                continue
            if absolute not in registered:
                add("J022", "error",
                    "media is not registered in draft_meta_info type 0: %s"
                    % item.get("path"), "materials.%s[%d]" % (group, i))
        material_paths = {_resolve(m[2].get("path"), draft_dir)[1] for m in media}
        for absolute, rec in registered.items():
            if absolute not in material_paths and not os.path.isfile(absolute):
                add("J023", "warning",
                    "stale draft_materials entry points at a missing file: %s"
                    % rec.get("file_Path"), "draft_meta_info.draft_materials")
        meta_duration = meta.get("tm_duration")
        if isinstance(meta_duration, int) and isinstance(duration, int) \
                and meta_duration != duration:
            add("J031", "warning",
                "tm_duration %s != draft duration %s"
                % (_fmt_us(meta_duration), _fmt_us(duration)), "draft_meta_info")

    leaked = [k for k in PRIVACY_KEYS if platform.get(k)]
    if leaked:
        add("J030", "warning",
            "draft carries machine fingerprint fields (%s); do not distribute "
            "this directory as-is" % ", ".join(leaked), "platform")

    if strict:
        for finding in findings:
            if finding["severity"] == "warning":
                finding["severity"] = "error"

    findings.sort(key=lambda f: (f["id"], f["where"]))
    errors = sum(1 for f in findings if f["severity"] == "error")
    warnings = sum(1 for f in findings if f["severity"] == "warning")
    result = {
        "tool": TOOL,
        "version": VERSION,
        "ok": errors == 0,
        "draft": given,
        "entry": os.path.basename(entry),
        "stats": {
            "tracks": track_count,
            "segments": segment_count,
            "materials": len(material_index),
            "media": len(media),
            "errors": errors,
            "warnings": warnings,
        },
        "findings": findings,
    }
    return result, (0 if errors == 0 else 1)


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=TOOL,
        description="Offline structural verifier for JianYing/CapCut drafts "
                    "written by video-shotcraft's jianying-export.")
    parser.add_argument("draft_dir", help="draft directory to inspect")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--strict", action="store_true",
                        help="treat warnings as errors (also makes external media fail)")
    parser.add_argument("--allow-external-media", action="store_true",
                        help="do not warn about media outside the draft directory")
    parser.add_argument("--quiet", action="store_true", help="only errors, no summary")
    parser.add_argument("--version", action="version", version="%s %s" % (TOOL, VERSION))
    args = parser.parse_args(argv)

    try:
        result, code = verify(args.draft_dir, strict=args.strict,
                              allow_external=args.allow_external_media)
    except InputError as exc:
        if args.json:
            print(json.dumps({"tool": TOOL, "version": VERSION, "ok": False,
                              "error": str(exc), "findings": []},
                             ensure_ascii=False, sort_keys=True))
        else:
            print("INPUT ERROR: %s" % exc, file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
    else:
        for finding in result["findings"]:
            if args.quiet and finding["severity"] != "error":
                continue
            print("%-7s %s %-18s %s" % (finding["severity"].upper(), finding["id"],
                                        finding["where"], finding["message"]))
        if not args.quiet:
            s = result["stats"]
            print("%s: %d track(s), %d segment(s), %d material(s), %d media, "
                  "%d error(s), %d warning(s)" %
                  ("OK" if result["ok"] else "FAIL", s["tracks"], s["segments"],
                   s["materials"], s["media"], s["errors"], s["warnings"]))
    return code


if __name__ == "__main__":
    sys.exit(main())